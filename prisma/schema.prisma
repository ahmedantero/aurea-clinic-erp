datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. CATEGORY MODEL
// ==========================================
model Category {
  id       String    @id @default(uuid())
  name     String
  services Service[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

// ==========================================
// 2. SERVICE MODEL
// ==========================================
model Service {
  id               String   @id @default(uuid())
  category_id      String
  name             String
  min_price        Float
  max_price        Float?
  duration_minutes Int
  type             String

  // Relationships
  category     Category            @relation(fields: [category_id], references: [id], onDelete: Cascade)
  consumables  ServiceConsumable[]
  appointments Appointment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("services")
}

// ==========================================
// 3. STAFF MODEL
// ==========================================
model Staff {
  id               String        @id @default(uuid())
  name             String
  specialty        String
  phone            String?
  commission_type  String
  commission_value Float
  appointments     Appointment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staff")
}

// ==========================================
// 4. CLIENT MODEL
// ==========================================
model Client {
  id              String        @id @default(uuid())
  name            String
  phone           String
  medical_history String?
  loyalty_points  Int           @default(0)
  appointments    Appointment[]
  invoices        Invoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clients")
}

// ==========================================
// 5. INVENTORY ITEM MODEL
// ==========================================
model InventoryItem {
  id                 String              @id @default(uuid())
  item_name          String
  unit_cost          Float
  quantity_in_stock  Float
  unit_type          String
  serviceConsumables ServiceConsumable[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventory_items")
}

// ==========================================
// 6. SERVICE CONSUMABLE MODEL (Join Table)
// ==========================================
model ServiceConsumable {
  id            String @id @default(uuid())
  service_id    String
  item_id       String
  quantity_used Float

  // Relationships
  service       Service       @relation(fields: [service_id], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [item_id], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([service_id, item_id])
  @@map("service_consumables")
}

// ==========================================
// 7. APPOINTMENT MODEL
// ==========================================
model Appointment {
  id               String   @id @default(uuid())
  client_id        String
  staff_id         String
  service_id       String
  appointment_date DateTime
  status           String   @default("Pending")
  final_price      Float

  // Relationships
  client  Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  staff   Staff    @relation(fields: [staff_id], references: [id], onDelete: Restrict)
  service Service  @relation(fields: [service_id], references: [id], onDelete: Restrict)
  invoice Invoice?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("appointments")
}

// ==========================================
// 8. PACKAGE MODEL
// ==========================================
model Package {
  id                  String   @id @default(uuid())
  package_name        String
  fixed_price         Float?
  discount_percentage Float?
  is_active           Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("packages")
}

// ==========================================
// 9. EXPENSE MODEL
// ==========================================
model Expense {
  id           String   @id @default(uuid())
  expense_date DateTime @default(now())
  expense_type String
  amount       Float
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("expenses")
}

// ==========================================
// 10. INVOICE MODEL
// ==========================================
model Invoice {
  id               String @id @default(uuid())
  client_id        String
  appointment_id   String @unique
  total_amount     Float
  discount_applied Float
  net_amount       Float
  payment_method   String

  // Relationships
  client      Client      @relation(fields: [client_id], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoices")
}

// ==========================================
// 11. USER MODEL
// ==========================================
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   // 'ADMIN' or 'RECEPTIONIST'
  name      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

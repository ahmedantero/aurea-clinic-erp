datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. CATEGORY MODEL
// ==========================================
model Category {
  id       String    @id @default(uuid())
  name     String
  services Service[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

// ==========================================
// 2. SERVICE MODEL
// ==========================================
model Service {
  id               String @id @default(uuid())
  category_id      String
  name             String
  min_price        Float
  max_price        Float?
  duration_minutes Int
  type             String
  sessions_count   Int    @default(1) @map("sessions_count")

  // Relationships
  category            Category             @relation(fields: [category_id], references: [id], onDelete: Cascade)
  consumables         ServiceConsumable[]
  appointments        Appointment[]
  clientPackages      ClientPackage[]
  appointmentServices AppointmentService[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("services")
}

// ==========================================
// 3. STAFF MODEL
// ==========================================
model Staff {
  id               String        @id @default(uuid())
  name             String
  specialty        String
  phone            String?
  commission_type     String
  commission_value    Float
  appointments        Appointment[]
  appointmentServices AppointmentService[]

  staffMemberId String?      @map("staff_member_id")
  staffMember   StaffMember? @relation("StaffToStaffMember", fields: [staffMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staff")
}

// ==========================================
// 4. CLIENT MODEL
// ==========================================
model Client {
  id              String          @id @default(uuid())
  name            String
  phone           String
  medical_history String?
  loyalty_points  Int             @default(0)
  appointments    Appointment[]
  invoices        Invoice[]
  clientPackages  ClientPackage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@index([name])
  @@map("clients")
}

// ==========================================
// 5. INVENTORY ITEM MODEL
// ==========================================
model InventoryItem {
  id                     String                  @id @default(uuid())
  item_name              String
  unit_cost              Float                   @default(0) @map("unit_cost")
  selling_price          Float                   @default(0) @map("selling_price")
  quantity_in_stock      Float                   @default(0) @map("quantity_in_stock")
  unit_type              String                  @default("قطعة") @map("unit_type")
  serviceConsumables     ServiceConsumable[]
  appointmentConsumables AppointmentConsumable[]
  internalDispatches     InternalDispatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventory_items")
}

// ==========================================
// 6. SERVICE CONSUMABLE MODEL (Join Table)
// ==========================================
model ServiceConsumable {
  id            String @id @default(uuid())
  service_id    String
  item_id       String
  quantity_used Float

  // Relationships
  service       Service       @relation(fields: [service_id], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [item_id], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([service_id, item_id])
  @@map("service_consumables")
}

// ==========================================
// 7. APPOINTMENT MODEL
// ==========================================
model Appointment {
  id                String   @id @default(uuid())
  client_id         String
  staff_id          String
  service_id        String?
  package_id        String?
  client_package_id String?
  appointment_date  DateTime
  status            String         @default("Pending")
  final_price       Float
  paymentMethod     PaymentMethod? @default(CASH) @map("payment_method")

  // Relationships
  client        Client         @relation(fields: [client_id], references: [id], onDelete: Restrict)
  staff         Staff          @relation(fields: [staff_id], references: [id], onDelete: Restrict)
  service       Service?       @relation(fields: [service_id], references: [id], onDelete: Restrict)
  package       Package?       @relation(fields: [package_id], references: [id], onDelete: Restrict)
  clientPackage ClientPackage? @relation(fields: [client_package_id], references: [id], onDelete: SetNull)
  invoice       Invoice?
  revenueId           String?                 @unique @map("revenue_id")
  revenue             Revenue?                @relation(fields: [revenueId], references: [id], onDelete: SetNull)
  consumables         AppointmentConsumable[]
  appointmentServices AppointmentService[]
  createdById         String?                 @map("created_by_id")
  createdBy     User?                   @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([appointment_date])
  @@index([status])
  @@index([client_id])
  @@index([staff_id])
  @@index([createdById])
  @@map("appointments")
}

// ==========================================
// 8. PACKAGE MODEL
// ==========================================
model Package {
  id                  String          @id @default(uuid())
  package_name        String
  fixed_price         Float?
  discount_percentage Float?
  sessions_count      Int             @default(1) @map("sessions_count")
  is_active           Boolean         @default(true)
  clientPackages      ClientPackage[]
  appointments        Appointment[]
  appointmentServices AppointmentService[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("packages")
}

// ==========================================
// 9. EXPENSE MODEL
// ==========================================
model Expense {
  id           String   @id @default(uuid())
  expense_date DateTime @default(now())
  expense_type String
  amount       Float
  notes        String?
  createdById  String?  @map("created_by_id")
  createdBy    User?    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expense_date])
  @@index([expense_type])
  @@map("expenses")
}

// ==========================================
// 10. INVOICE MODEL
// ==========================================
model Invoice {
  id               String @id @default(uuid())
  client_id        String
  appointment_id   String @unique
  total_amount     Float
  discount_applied Float
  net_amount       Float
  payment_method   String

  // Relationships
  client      Client      @relation(fields: [client_id], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Restrict)
  createdById String?     @map("created_by_id")
  createdBy   User?       @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([client_id])
  @@index([createdAt])
  @@map("invoices")
}

// ==========================================
// 11. USER MODEL
// ==========================================
model User {
  id       String  @id @default(uuid())
  username String  @unique
  password String
  role     String // 'ADMIN' or 'RECEPTIONIST'
  name     String?

  staffId     String?      @map("staff_id")
  staffMember StaffMember? @relation("UserStaffMember", fields: [staffId], references: [id], onDelete: SetNull)

  appointments       Appointment[]      @relation("AppointmentCreatedBy")
  invoices           Invoice[]          @relation("InvoiceCreatedBy")
  expenses           Expense[]          @relation("ExpenseCreatedBy")
  revenues           Revenue[]          @relation("RevenueCreatedBy")
  internalDispatches InternalDispatch[] @relation("InternalDispatchCreatedBy")
  staffMembers       StaffMember[]      @relation("StaffMemberCreatedBy")
  staffTransactions  StaffTransaction[] @relation("StaffTransactionCreatedBy")
  payrollRecords     PayrollRecord[]    @relation("PayrollRecordCreatedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ==========================================
// 12. CLIENT PACKAGE MODEL (Multi-Session Tracking)
// ==========================================
model ClientPackage {
  id             String  @id @default(uuid())
  client_id      String
  package_id     String?
  service_id     String?
  package_name   String?
  total_sessions Int
  used_sessions  Int     @default(0)
  price_paid     Float   @default(0)
  status         String  @default("ACTIVE") // ACTIVE | COMPLETED
  notes          String?

  // Relationships
  client       Client        @relation(fields: [client_id], references: [id], onDelete: Cascade)
  package      Package?      @relation(fields: [package_id], references: [id], onDelete: SetNull)
  service      Service?      @relation(fields: [service_id], references: [id], onDelete: SetNull)
  appointments        Appointment[]
  appointmentServices AppointmentService[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([client_id, status])
  @@map("client_packages")
}

// ==========================================
// 13. REVENUE MODEL (الإيرادات)
// ==========================================
model Revenue {
  id            String        @id @default(uuid())
  amount        Float
  date          DateTime      @default(now())
  category      String
  description   String?
  source        String        @default("MANUAL") // MANUAL | APPOINTMENT
  referenceId   String?       @unique @map("reference_id")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  appointment   Appointment?
  createdById   String?       @map("created_by_id")
  createdBy     User?         @relation("RevenueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([category])
  @@index([paymentMethod])
  @@map("revenues")
}

// ==========================================
// 14. APPOINTMENT CONSUMABLE MODEL (Add-ons used during session)
// ==========================================
model AppointmentConsumable {
  id               String        @id @default(uuid())
  appointmentId    String        @map("appointment_id")
  productId        String        @map("product_id")
  quantity         Float         @default(1)
  priceCharged     Float         @default(0) @map("price_charged")
  isBilledToClient Boolean       @default(false) @map("is_billed_to_client")

  appointment  Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  product      InventoryItem @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("appointment_consumables")
}

// ==========================================
// 15. INTERNAL DISPATCH MODEL (Clinic's internal consumption)
// ==========================================
model InternalDispatch {
  id          String        @id @default(uuid())
  productId   String        @map("product_id")
  quantity    Float         @default(1)
  totalCost   Float         @default(0) @map("total_cost")
  date        DateTime      @default(now())
  notes       String?
  createdById String?       @map("created_by_id")
  createdBy   User?         @relation("InternalDispatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  product     InventoryItem @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("internal_dispatches")
}

// ==========================================
// 16. PAYMENT METHOD ENUM
// ==========================================
enum PaymentMethod {
  CASH
  WALLET
  INSTAPAY
}

// ==========================================
// 17. STAFF MEMBER MODEL (HR & Payroll)
// ==========================================
model StaffMember {
  id           String             @id @default(uuid())
  name         String
  role         String             // e.g. "طبيب", "أخصائي", "استقبال", "تمريض", "إداري"
  baseSalary   Float              @default(0) @map("base_salary")
  phone        String?
  joinDate     DateTime           @default(now()) @map("join_date")
  status       String             @default("Active") // Active | Inactive
  createdById  String?            @map("created_by_id")
  createdBy    User?              @relation("StaffMemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  transactions StaffTransaction[]
  payrolls     PayrollRecord[]
  userAccounts User[]             @relation("UserStaffMember")
  staffRecords Staff[]            @relation("StaffToStaffMember")

  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@map("staff_members")
}

// ==========================================
// 18. STAFF TRANSACTION MODEL (سلف، مكافآت، خصومات)
// ==========================================
model StaffTransaction {
  id          String      @id @default(uuid())
  staffId     String      @map("staff_id")
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type        String      // ADVANCE (سلفة) | BONUS (مكافأة) | DEDUCTION (خصم)
  amount      Float
  date        DateTime    @default(now())
  notes       String?
  createdById String?     @map("created_by_id")
  createdBy   User?       @relation("StaffTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([staffId, date])
  @@map("staff_transactions")
}

// ==========================================
// 19. PAYROLL RECORD MODEL (مسير الرواتب)
// ==========================================
model PayrollRecord {
  id              String      @id @default(uuid())
  staffId         String      @map("staff_id")
  staff           StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  monthYear       String      @map("month_year") // e.g. "10-2026"
  baseSalary      Float       @map("base_salary")
  totalBonuses    Float       @default(0) @map("total_bonuses")
  totalDeductions Float       @default(0) @map("total_deductions")
  totalAdvances   Float       @default(0) @map("total_advances")
  netPaid         Float       @map("net_paid")
  paymentDate     DateTime    @default(now()) @map("payment_date")
  notes           String?
  createdById     String?     @map("created_by_id")
  createdBy       User?       @relation("PayrollRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([staffId, monthYear])
  @@index([monthYear])
  @@map("payroll_records")
}

// ==========================================
// 20. APPOINTMENT SERVICE MODEL (Multi-Service Support)
// ==========================================
model AppointmentService {
  id                String   @id @default(uuid())
  appointment_id    String   @map("appointment_id")
  service_id        String?  @map("service_id")
  package_id        String?  @map("package_id")
  client_package_id String?  @map("client_package_id")
  service_name      String   @map("service_name")
  price             Float    @default(0)
  duration_minutes  Int      @default(30) @map("duration_minutes")
  staff_id          String?  @map("staff_id")

  // Relationships
  appointment   Appointment    @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [service_id], references: [id], onDelete: SetNull)
  package       Package?       @relation(fields: [package_id], references: [id], onDelete: SetNull)
  clientPackage ClientPackage? @relation(fields: [client_package_id], references: [id], onDelete: SetNull)
  staff         Staff?         @relation(fields: [staff_id], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([appointment_id])
  @@map("appointment_services")
}

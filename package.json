{
  "name": "clinic-spa-management-db",
  "version": "1.0.0",
  "description": "PostgreSQL database schema for Clinic and Spa Management System using Prisma ORM",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "postinstall": "prisma generate",
    "start": "node server.js",
    "dev": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --test tests/unit/*.test.js tests/validation/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:validation": "node --test tests/validation/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
